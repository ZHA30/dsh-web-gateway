{
  "name": "dsh-web-gateway",
  "version": "0.1.2",
  "type": "module",
  "main": "./src/host/index.js",
  "description": "Web Gateway, Basic Auth and Cloudflare Tunnel for DeepSeek Harness",
  "engines": {
    "dsh": "0.2.2-rc.5",
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "qrcode-generator": "^2.0.4"
  },
  "files": [
    "cordis.patch.yml",
    "src",
    "assets",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/host/index.js && node --check src/host/auth.js && node --check src/host/proxy.js && node --check src/host/cloudflare.js && node --check src/host/managed-cloudflared.js && node --check src/client/index.js"
  },
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZHA30/dsh-web-gateway.git"
  },
  "homepage": "https://github.com/ZHA30/dsh-web-gateway#readme",
  "bugs": {
    "url": "https://github.com/ZHA30/dsh-web-gateway/issues"
  }
}
